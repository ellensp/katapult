CONFIG_LOW_LEVEL_OPTIONS=y
# CONFIG_MACH_LPC176X is not set
# CONFIG_MACH_STM32 is not set
# CONFIG_MACH_RPXXXX is not set
CONFIG_MACH_LPC55=y
CONFIG_BOARD_DIRECTORY="lpc55"
CONFIG_MCU="lpc5528"
CONFIG_CLOCK_FREQ=48000000
CONFIG_FLASH_SIZE=0x80000
CONFIG_FLASH_BOOT_ADDRESS=0x0
CONFIG_RAM_START=0x20004000
CONFIG_RAM_SIZE=0xbfe0
CONFIG_STACK_SIZE=512
CONFIG_FLASH_APPLICATION_ADDRESS=0x0
CONFIG_FLASH_START=0x0
CONFIG_LAUNCH_APP_ADDRESS=0x2000
CONFIG_BLOCK_SIZE=64
CONFIG_LPC55_SELECT=y
CONFIG_MACH_LPC5528=y
CONFIG_LPC55_USB0=y
CONFIG_LPC55_APP_START_2000=y
# CONFIG_LPC55_APP_START_4000 is not set
# CONFIG_LPC55_APP_START_8000 is not set
CONFIG_USBSERIAL=y
CONFIG_USB=y
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x6177
CONFIG_USB_SERIAL_NUMBER="12345"

#
# USB ids
#
# end of USB ids

CONFIG_CANBUS_FREQUENCY=1000000
CONFIG_HAVE_OPTIMIZE_OS=y
# CONFIG_HAVE_OPTIMIZE_O2 is not set
# CONFIG_HAVE_OPTIMIZE_OZ is not set
# CONFIG_HAVE_OPTIMIZE_OG is not set
# CONFIG_HAVE_OPTIMIZE_O0 is not set
CONFIG_OPTIMIZE_FLAG="-Os"
CONFIG_INITIAL_PINS=""
CONFIG_ENABLE_DOUBLE_RESET=y
# CONFIG_ENABLE_BUTTON is not set
# CONFIG_ENABLE_LED is not set
CONFIG_HAVE_BOARD_FLASH_READ=y
