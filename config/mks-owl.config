# Katapult for MKS Owl (NXP LPC5528), USB on the USB-C port (USB0).
# Katapult occupies the first 8KiB; build Marlin with an 8KiB offset.
# Build with: cp config/mks-owl.config .config && make olddefconfig && make
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_LPC55=y
CONFIG_MACH_LPC5528=y
CONFIG_LPC55_USB0=y
CONFIG_LPC55_APP_START_2000=y
CONFIG_ENABLE_DOUBLE_RESET=y
